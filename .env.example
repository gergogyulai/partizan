# --- Required -------------------------------------------------------------
# The YouTube channel: @handle, channel URL, or UC... channel id.
CHANNEL=@YourChannel

# --- Channel appearance ---------------------------------------------------
# Defaults to the name/avatar from YouTube.
#CHANNEL_NAME=My Channel
#CHANNEL_LOGO=https://example.com/logo.png
#TVG_ID=mychannel
#CHANNEL_NUMBER=1

# --- Server ---------------------------------------------------------------
#PORT=8080
# Public address used in the playlist/guide URLs. Auto-detected from the request if unset.
#BASE_URL=http://192.168.1.10:8080

# --- What plays -----------------------------------------------------------
# Which channel tabs to take videos from: videos, streams (past livestreams), shorts
#LIBRARY_TABS=videos
#LIBRARY_MAX=300
# Skip videos shorter/longer than this many seconds (0 = no maximum).
#MIN_DURATION=60
#MAX_DURATION=0
# shuffle | newest | oldest
#ORDER=shuffle

# --- Live detection -------------------------------------------------------
# Seconds between checks for a livestream.
#LIVE_POLL_INTERVAL=60
# How long a livestream is assumed to run in the guide (extended while it's still live).
#LIVE_BLOCK_MINUTES=60
#LIBRARY_REFRESH_INTERVAL=21600

# --- Guide ----------------------------------------------------------------
#EPG_HOURS=48
#EPG_PAST_HOURS=6

# --- Video output ---------------------------------------------------------
# transcode: every video is re-encoded to the same H.264 format (most compatible, uses CPU)
# copy:      pass YouTube's H.264 through untouched (very light, resolution may change between videos)
#MODE=transcode
#VIDEO_HEIGHT=720
#FPS=30
#VIDEO_BITRATE=3000k
#AUDIO_BITRATE=128k
#X264_PRESET=veryfast
# Replace the whole video encoder section of the ffmpeg command (advanced, e.g. hardware encoding).
#FFMPEG_VIDEO_ARGS=

# --- Pipeline -------------------------------------------------------------
# Keep the stream running with nobody watching (faster tune-in, constant CPU use).
#ALWAYS_ON=false
# Seconds to keep the pipeline alive after the last viewer leaves.
#IDLE_TIMEOUT=30

# --- yt-dlp ---------------------------------------------------------------
# Netscape-format cookies file, if YouTube asks you to sign in.
#YTDLP_COOKIES=/cookies.txt
#YTDLP_FORMAT=
#YTDLP_FORMAT_LIVE=
# Update yt-dlp each time the container starts.
#UPDATE_YTDLP=true

#LOG_LEVEL=INFO
